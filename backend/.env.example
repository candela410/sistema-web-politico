# Copiar a backend/.env y completar. Nunca subir .env al repositorio.
# Cadena de conexión de Neon (proyecto noisy-haze-97297807, rama production)
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST.neon.tech/neondb?sslmode=require

DJANGO_SECRET_KEY=cambiar-esto
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Envío de correos por Gmail. EMAIL_CLAVE es una contraseña de aplicación de Google
# (https://myaccount.google.com/apppasswords), no la clave de la cuenta.
# Sin estas dos líneas los correos se muestran en la terminal de runserver.
EMAIL_USUARIO=
EMAIL_CLAVE=
# Correos que existen de verdad, separados por coma. Al restablecer la contraseña
# de un usuario con otro correo, el enlace le llega a quien lo pidió.
CORREOS_REALES=

# API key de OpenRouteService para calcular rutas (https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=
