# Copiar a backend/.env y completar. Nunca subir .env al repositorio.
# Cadena de conexión de Neon (proyecto noisy-haze-97297807, rama production)
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST.neon.tech/neondb?sslmode=require

DJANGO_SECRET_KEY=cambiar-esto
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# API key de OpenRouteService para calcular rutas (https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=
