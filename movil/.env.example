# Dirección del backend Django, vista desde el celular. OPCIONAL en desarrollo:
# si no se completa, la app usa la IP de la compu que corre Expo (la del QR) con
# el puerto 8000. Completarla solo si Django corre en otra máquina o en producción.
# No sirve 127.0.0.1: para el celular eso es el propio celular.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
# En producción, la dirección pública (por ejemplo, la de Render):
# EXPO_PUBLIC_API_URL=https://mi-backend.onrender.com
